{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/echohive/config/*"],
      "@controllers/*": ["src/echohive/controllers/*"],
      "@middleware/*": ["src/echohive/middleware/*"],
      "@routes/*": ["src/echohive/routes/*"],
      "@sockets/*": ["src/echohive/sockets/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
